# BlueHash agent (csid) environment.
# Copy to `.env` (gitignored) and fill in.
#
# Both vars are required for the broker — csid won't error on missing
# values but every Supabase-backed operation (device register, key
# distribution, heartbeat) will silently fail, leaving the daemon in
# "Waiting for PNK" forever.

SUPABASE_PROJECT_URL=https://mxgffpaxfjphoxnmvjqn.supabase.co
SUPABASE_ANON_KEY=sb_publishable_fNY6vIb2dOyowKu0sxYx3w_JvxKQFLB

# Tracing filter. Verbose: "debug,csid=trace,csi_core=trace".
# Default if unset: "csid=info,csi_core=info,warn".
RUST_LOG=csid=info,csi_core=info,warn
